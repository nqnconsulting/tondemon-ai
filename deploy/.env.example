# Tondemon AI — server env. Copy to `.env` on the server. NEVER commit.
#   cp .env.example .env  &&  edit

# --- Public endpoint ---
DOMAIN=tondemon.example.com                 # Caddy auto-HTTPS for this domain (DNS A → server IP)
MCP_AUTH_TOKEN=replace-with-long-random     # bearer token agents must send (openssl rand -hex 32)

# --- Data source: pick ONE ---
# (a) Live Anypoint Platform (CloudHub 2.0, read-only):
ANYPOINT_CLIENT_ID=
ANYPOINT_CLIENT_SECRET=
ANYPOINT_BG_ID=
CH2_ENV=Sandbox
# ANYPOINT_ENV_ID=                          # optional, skips env lookup
# ANYPOINT_HOST=anypoint.mulesoft.com

# (b) Live Mule logs — mount a volume in docker-compose.yml and set:
# MULE_LOG_DIR=/logs

# (c) Demo mode — leave all of the above unset.

# --- Slack bridge (optional) — @mention/DM a Slack bot to query the estate ---
# Leave unset to disable. See deploy/SLACK.md for the Slack app setup.
# SLACK_BOT_TOKEN=xoxb-...                    # Bot User OAuth Token (scopes: app_mentions:read, chat:write, im:history, reactions:write)
# SLACK_APP_TOKEN=xapp-...                    # App-Level Token with connections:write (enables Socket Mode)
# ANTHROPIC_API_KEY=sk-ant-...               # the bot calls Claude to interpret questions + write answers
# TONDEMON_MCP_URL=https://your-server.example.com/mcp
# TONDEMON_TOKEN=                            # same value as MCP_AUTH_TOKEN above
# ANTHROPIC_MODEL=claude-sonnet-4-6          # optional override
# SLACK_MAX_TOKENS=1024                       # optional
